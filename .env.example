# PostgreSQL
POSTGRES_DB=college_it
POSTGRES_USER=college_it
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Backend
APP_ENV=development
APP_NAME=College IT Management System
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://college_it:replace-with-a-local-development-password@database:5432/college_it
JWT_SECRET_KEY=replace-with-a-unique-local-development-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=college-it-api
JWT_AUDIENCE=college-it-client
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
